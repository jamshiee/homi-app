{
  "expo": {
    "name": "Homi Holdings",
    "slug": "homi-holdings",
    "backgroundColor": "#FFC914",
    "scheme": "homi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFC914"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jamshiiie.homiholdings",
      "splash": {
        "backgroundColor": "#FFC914"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Homi uses your location to show properties near you and calculate distance to listings. For example, when you open the map, we'll center it on your area and highlight nearby plots and houses first.",
"NSPhotoLibraryUsageDescription": "Homi needs access to your photo library so you can upload property photos when listing a plot, house, or building for sale or rent.",
"NSCameraUsageDescription": "Homi needs camera access so you can take photos of your property directly when creating a listing."
      },
      "associatedDomains": [
        "applinks:homiholdings.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.jamshiiie.homiholdings",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA-eJyXIOaAwxHmc6A7mwuKgWSBFi2KVXg"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "homiholdings.com",
              "pathPrefix": "/property"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "963cf11c-9b0d-4f99-9c98-2dff935ff68d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/963cf11c-9b0d-4f99-9c98-2dff935ff68d"
    },
    "owner": "jamshiiie"
  }
}
